.header {
  position: sticky;
  top: 0;
  z-index: 20;
}
.bar {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  padding: 0 250rpx 0 38rpx;
  gap: 20rpx;
}
.heading {
  font-size: 42rpx;
  font-weight: 650;
  white-space: nowrap;
  line-height: 1.3;
  color: #30392e;
}
.back {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0 0 0 -14rpx;
  width: 44rpx;
  min-width: 44rpx;
  height: 72rpx;
  background: transparent;
  line-height: 1;
}
.back::after {
  border: 0;
}
.icon {
  width: 30rpx;
  height: 30rpx;
}
.back {
  width: 44rpx !important;
  min-width: 44rpx !important;
}
