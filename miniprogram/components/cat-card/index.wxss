.cat-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  padding: 30rpx 0 20rpx;
  color: #30392e;
}
.cat-copy {
  min-width: 0;
  flex: 1;
}
.cat-name {
  font-size: 29rpx;
  font-weight: 600;
}
.cat-caption {
  color: #737c6d;
  font-size: 24rpx;
  margin-top: 8rpx;
}
.cat-id {
  font-size: 20rpx;
  color: #737c6d;
  margin-top: 4rpx;
}
.chevron {
  width: 24rpx;
  height: 24rpx;
}

.catalog-card { box-sizing: border-box; min-height: 122rpx; padding: 22rpx 28rpx; border-radius: 20rpx; background: #f6f4ed; }
.catalog-card .cat-caption { margin-top: 6rpx; font-size: 22rpx; line-height: 1.6; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.catalog-card .chevron { flex-shrink: 0; width: 22rpx; height: 22rpx; }
