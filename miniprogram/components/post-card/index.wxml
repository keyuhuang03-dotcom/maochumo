<view class="post-card {{detail ? 'detail-card' : ''}}" bindtap="open"><view class="byline"><text class="author">{{post.author.nickname || '校园同学'}}</text><text class="time">{{detail ? '' : ' · '}}{{timeLabel}}</text></view><view class="post-body">{{post.body}}</view>
<view class="photos {{post.images.length === 1 ? 'one-photo' : ''}}"><image wx:for="{{post.images}}" wx:key="*this" src="{{item}}" mode="aspectFill" data-url="{{item}}" catchtap="preview" class="photo" aria-label="查看帖子图片"/></view>
<view class="tags"><button wx:for="{{post.topics}}" wx:key="id" class="tag-button" data-id="{{item.id}}" catchtap="topic"># {{item.name}}</button><button wx:for="{{post.cats}}" wx:key="id" class="tag-button" data-id="{{item.id}}" catchtap="cat"># {{item.name}}</button></view>
<view class="actions" wx:if="{{!detail}}"><button class="action {{post.liked ? 'liked' : ''}}" catchtap="like" loading="{{liking}}" disabled="{{liking}}"><image class="action-icon" src="/assets/ui/heart-{{post.liked ? 'white' : 'green'}}.png"/>{{post.likeCount}}</button><button class="action" catchtap="open">评论 {{post.commentCount}}</button></view><view class="message" wx:if="{{message}}">{{message}}</view></view>
