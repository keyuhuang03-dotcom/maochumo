<view class="card" bindtap="open" role="button" aria-label="查看帖子详情"><view>{{post.author.nickname || '校园同学'}}</view><view style="margin:16rpx 0;white-space:pre-wrap">{{post.body}}</view><view class="muted">{{post.likeCount}} 赞 · {{post.commentCount}} 评论</view><view class="muted" wx:if="{{post.cats.length}}">关联猫咪：<text wx:for="{{post.cats}}" wx:key="id">{{item.name}} </text></view></view>
