<view class="container"><view>未读 {{unreadCount}}</view><button bindtap="markAllRead" disabled="{{busy || loading}}">全部标为已读</button><view-state state="{{state}}" message="{{message}}" bind:retry="retry"/><view wx:for="{{list}}" wx:key="id" class="msg-item"><view bindtap="openPost" data-id="{{item.id}}">{{item.type === 'reply' ? '有人回复了你的评论' : '你的帖子有新评论'}} · {{item.readAt ? '已读' : '未读'}}<view wx:if="{{!item.targetAvailable}}">内容已隐藏或删除</view></view><button wx:if="{{!item.readAt}}" bindtap="markRead" data-id="{{item.id}}" disabled="{{busy}}">标记已读</button></view><button wx:if="{{hasMore}}" bindtap="more" disabled="{{loading}}">加载更多</button><button bindtap="back">返回</button></view>
