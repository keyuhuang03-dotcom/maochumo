.container {
  padding: 30rpx;
  background-color: #FFFEFA;
  min-height: 100vh;
}
.form-item {
  background: #fff;
  padding: 30rpx;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}
.form-item text {
  display: block;
  font-size: 28rpx;
  margin-bottom: 12rpx;
  color: #333;
}
input, textarea {
  font-size: 30rpx;
  width: 100%;
}
button {
  margin-top: 20rpx;
}
