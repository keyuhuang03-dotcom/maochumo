<view class="container"><view wx:if="{{!ready}}"><view>{{message}}</view><button bindtap="retry">重新加载</button></view><block wx:else><view class="form-item"><text>头像</text><image wx:if="{{avatarPath}}" src="{{avatarPath}}" style="width:140rpx;height:140rpx;border-radius:50%"/><button bindtap="chooseAvatar" disabled="{{busy}}">选择头像</button></view><view class="form-item"><text>昵称</text><input value="{{nickname}}" bindinput="setNick" maxlength="80" placeholder="输入昵称" disabled="{{busy}}"/></view><view class="notice">{{message}}</view><button bindtap="save" disabled="{{busy}}" loading="{{busy}}">保存资料</button><button bindtap="logout" disabled="{{busy}}">退出登录</button></block><button bindtap="back">返回</button></view>
