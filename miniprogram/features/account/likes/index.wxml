<view class="container"><view-state state="{{state}}" message="{{message}}" bind:retry="retry"/><view wx:for="{{list}}" wx:key="id"><post-card post="{{item}}" bind:open="openPost"/></view><view wx:if="{{message && state !== 'error'}}">{{message}}</view><button wx:if="{{hasMore}}" bindtap="more" disabled="{{loading}}">加载更多</button><button bindtap="back">返回</button></view>
