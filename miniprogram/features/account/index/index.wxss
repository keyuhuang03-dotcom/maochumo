.container {
  padding: 30rpx;
  background-color: #FFFEFA;
  min-height: 100vh;
}
.user-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
}
.nickname {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}
.bio {
  font-size: 28rpx;
  color: #666;
}
.menu-item {
  background: #fff;
  padding: 32rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 30rpx;
}
.badge {
  background: #f55;
  color: white;
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
}
