page { background: #fffefa; }
.account-page { box-sizing: border-box; padding: 30rpx 32rpx 56rpx; }
.profile { display: flex; align-items: center; gap: 30rpx; width: 100% !important; min-width: 0 !important; margin: 0 0 82rpx; padding: 0 8rpx; min-height: 132rpx; background: transparent; border-radius: 0; color: #30392e; text-align: left; }
.profile::after, .menu-item::after, .retry::after { border: 0; }
.avatar { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 132rpx; height: 132rpx; overflow: hidden; border-radius: 50%; background: #e8eedd; }
.avatar-image { width: 100%; height: 100%; }
.avatar-letter { color: #587649; font-size: 46rpx; font-weight: 400; line-height: 1; }
.profile-copy, .menu-copy { flex: 1; min-width: 0; }
.nickname { font-size: 38rpx; font-weight: 650; line-height: 1.4; overflow-wrap: anywhere; }
.profile-caption { margin-top: 12rpx; font-size: 23rpx; line-height: 1.6; color: #737c6d; font-weight: 400; }
.menu-list { display: flex; flex-direction: column; gap: 30rpx; }
.menu-item { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; box-sizing: border-box; width: 100% !important; min-width: 0 !important; min-height: 122rpx; margin: 0; padding: 22rpx 28rpx; border-radius: 20rpx; background: #f6f4ed; text-align: left; color: #30392e; }
.menu-title { display: flex; align-items: center; gap: 14rpx; font-size: 29rpx; font-weight: 650; line-height: 1.45; }
.menu-caption { margin-top: 6rpx; color: #737c6d; font-size: 22rpx; font-weight: 400; line-height: 1.6; }
.menu-arrow { flex-shrink: 0; width: 22rpx; height: 22rpx; }
.unread { display: inline-flex; align-items: center; justify-content: center; min-width: 24rpx; height: 26rpx; padding: 0 4rpx; border: 1rpx solid #30392e; border-radius: 30rpx; box-sizing: border-box; font-size: 19rpx; font-weight: 500; line-height: 1; }
.account-error { margin: -44rpx 8rpx 30rpx; color: #737c6d; font-size: 24rpx; }
.retry { display: inline-block; width: auto !important; margin: 12rpx 0 0; min-height: 64rpx; padding: 12rpx 20rpx; font-size: 24rpx; }
