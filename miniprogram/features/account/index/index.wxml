<view class="container">
  <view wx:if="{{user}}" class="user-card">
    <view class="nickname">{{user.nickname}}</view>
    <image wx:if="{{avatarUrl}}" src="{{avatarUrl}}" style="width:100rpx;height:100rpx;border-radius:50%"/>
  </view>
  <button wx:if="{{!loggedIn}}" bindtap="login">登录猫出没</button>
  <view class="notice">{{message}}</view>
  <view class="menu-list">
    <view class="menu-item" bindtap="gotoMessages">
      <text>消息通知</text>
      <view wx:if="{{unreadCount > 0}}" class="badge">{{unreadCount}}</view>
    </view>
    <view class="menu-item" bindtap="gotoPosts">我的发布</view>
    <view class="menu-item" bindtap="gotoLikes">我的点赞</view>
    <view class="menu-item" bindtap="gotoSettings">资料设置</view>
    <view wx:if="{{admin}}" class="menu-item" data-route="admin" bindtap="open">管理员工作台</view>
  </view>
</view>
