.map-page {
  padding: 20rpx 24rpx 26rpx;
}
.area-scroll {
  white-space: nowrap;
  margin-bottom: 24rpx;
}
.area-tabs {
  display: flex;
  gap: 14rpx;
  min-width: 100%;
  width: max-content;
}
.area-tab {
  flex: 1;
  white-space: nowrap;
  min-width: 126rpx;
  min-height: 54rpx;
  margin: 0;
  padding: 12rpx 18rpx;
  border-radius: 12rpx;
  background: #e8eedd;
  color: #587649;
  font-size: 23rpx;
  line-height: 1.4;
}
.area-tab.selected {
  background: #587649;
  color: white;
}
.map-scroll {
  height: 770rpx;
  width: 100%;
  background: #f6f4ed;
}
.map-artwork {
  position: relative;
  line-height: 0;
}
.campus-art {
  display: block;
  width: 100%;
}
.region-hit {
  position: absolute;
  margin: 0;
  padding: 0;
  min-height: 0;
  background: transparent;
  border-radius: 20rpx;
  border: 2px solid transparent;
}
.region-selected {
  border-color: #587649;
  background: rgba(88, 118, 73, 0.1);
}
.region-pin {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #587649;
  border: 3px solid white;
  position: absolute;
  top: 50%;
  left: 50%;
  margin: -12rpx 0 0 -12rpx;
}
.map-tip {
  text-align: center;
  color: #737c6d;
  font-size: 22rpx;
  padding: 14rpx 0;
}
.area-sheet {
  background: #f6f4ed;
  border-radius: 28rpx;
  min-height: 230rpx;
  padding: 26rpx 30rpx;
}
.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
}
.sheet-hint {
  font-size: 26rpx;
  color: #737c6d;
  margin-top: 34rpx;
}
.demo-note {
  font-size: 20rpx;
  color: #737c6d;
  margin: 16rpx 6rpx 0;
}
.area-tab {
  width: auto;
}
.area-tabs {
  width: 100%;
  min-width: 100%;
}
.area-tab {
  width: calc((100% - 42rpx) / 4) !important;
  min-width: 0 !important;
  flex: 0 0 calc((100% - 42rpx) / 4);
}
