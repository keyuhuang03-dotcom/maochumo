<view class="page"><view class="title">校园猫咪地图</view><view class="notice">示意底图，非真实校园。仅展示主要活动区域，不代表实时位置，也不保证遇见猫咪。</view><view class="map"><button wx:for="{{areas}}" wx:key="id" data-id="{{item.id}}" bindtap="choose" class="region" style="left:{{item.region.x * 100}}%;top:{{item.region.y * 100}}%;width:{{item.region.width * 100}}%;height:{{item.region.height * 100}}%">{{item.name}}</button></view><view class="title" style="font-size:32rpx">{{areaName || '点击上方区域'}}</view><cat-card wx:for="{{cats}}" wx:key="id" cat="{{item}}" bind:open="openCat"/><view-state state="{{state}}" message="{{message}}" bind:retry="load"/></view>
