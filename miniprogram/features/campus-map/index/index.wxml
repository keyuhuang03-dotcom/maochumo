<ui-header title="校园地图"/><view class="map-page"><scroll-view class="area-scroll" scroll-x><view class="area-tabs"><button class="area-tab {{!areaId ? 'selected' : ''}}" bindtap="all">全部</button><button wx:for="{{areas}}" wx:key="id" data-id="{{item.id}}" bindtap="choose" class="area-tab {{areaId === item.id ? 'selected' : ''}}">{{item.label || item.name}}</button></view></scroll-view>
<view-state state="{{mapState}}" message="{{mapError}}" bind:retry="load"/><scroll-view class="map-scroll" scroll-y enhanced><view class="map-artwork"><image class="campus-art" src="/assets/ui/campus-demo.jpg" mode="widthFix"/><button wx:for="{{areas}}" wx:key="id" data-id="{{item.id}}" bindtap="choose" aria-label="{{item.name}}演示选区" class="region-hit {{areaId === item.id ? 'region-selected' : ''}}" style="left:{{item.region.x * 100}}%;top:{{item.region.y * 100}}%;width:{{item.region.width * 100}}%;height:{{item.region.height * 100}}%"><view class="region-pin" wx:if="{{areaId === item.id}}"></view></button></view></scroll-view>
<view class="map-tip">点击地图区域查看猫咪 · 可上下滑动地图</view><view class="area-sheet"><view class="sheet-title">{{areaName ? areaName + '附近的猫咪' : '选择一个区域'}}</view><view class="sheet-hint" wx:if="{{!areaId}}">点击上方区域或地图，查看猫咪档案入口</view><cat-card wx:for="{{cats}}" wx:key="id" cat="{{item}}" bind:open="openCat"/><view-state state="{{state}}" message="{{state === 'empty' ? '该区域暂无猫咪资料' : message}}" bind:retry="retry"/><button wx:if="{{hasMore}}" bindtap="more" disabled="{{state === 'loading'}}">更多猫咪</button></view><view class="demo-note">演示素材与选区，地名和范围待核对；非实时位置。</view></view>
