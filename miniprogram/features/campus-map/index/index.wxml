<view class="page"><view class="title">校园猫咪地图</view><view class="notice">演示底图 · 非真实校园。仅展示主要活动区域，不代表实时位置，也不保证遇见猫咪。</view>
<view-state state="{{mapState}}" message="{{mapError}}" bind:retry="load"/><view class="map" wx:if="{{areas.length}}"><view class="walkway"></view><button wx:for="{{areas}}" wx:key="id" data-id="{{item.id}}" bindtap="choose" class="region {{areaId === item.id ? 'active' : ''}}" style="left:{{item.region.x * 100}}%;top:{{item.region.y * 100}}%;width:{{item.region.width * 100}}%;height:{{item.region.height * 100}}%">{{item.name}}</button><view class="map-label">校园区域示意</view></view>
<view class="area-buttons"><button wx:for="{{areas}}" wx:key="id" data-id="{{item.id}}" bindtap="choose" class="{{areaId === item.id ? 'active' : ''}}">{{item.name}}</button></view>
<view class="title" style="font-size:32rpx">{{areaName || '点击上方区域查看猫咪'}}</view><cat-card wx:for="{{cats}}" wx:key="id" cat="{{item}}" bind:open="openCat"/><view-state state="{{state}}" message="{{state === 'empty' ? '该区域暂无猫咪资料' : message}}" bind:retry="retry"/><button wx:if="{{hasMore}}" bindtap="more" disabled="{{state === 'loading'}}">更多猫咪</button></view>
