<ui-header title="猫出没" background="#F0F3EA"/><view class="feed-page"><view class="feed-tools" style="top:{{toolbarTop}}px"><button class="search-field" bindtap="search"><image class="ui-icon" src="/assets/ui/search-muted.png"/><text>搜索正文或 Tag</text></button><button class="hot-preview" bindtap="hot"><view class="hot-title">十大热帖 · 近 7 天<image class="tiny-icon" src="/assets/ui/right-green.png"/></view><view class="hot-summary">{{hotPost ? '01  ' + (hotPost.body || '图片分享') : '看看最近大家在聊什么'}}</view></button><view class="section-title">最新帖子</view></view><post-card wx:for="{{posts}}" wx:key="id" post="{{item}}" bind:open="openPost"/><view-state state="{{state}}" message="{{message}}" bind:retry="load"/><button class="more-button" wx:if="{{hasMore}}" bindtap="more" disabled="{{state === 'loading'}}">加载更多</button><view class="feed-end" wx:elif="{{posts.length && state === 'ready'}}">已经看到全部帖子了</view></view>
