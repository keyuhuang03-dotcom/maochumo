<view class="page"><view class="title">帖子详情</view><view-state state="{{state}}" message="{{message}}" bind:retry="load"/><view wx:if="{{post}}"><post-card post="{{post}}"/>
<button bindtap="like" loading="{{liking}}" disabled="{{liking}}">{{likeTarget !== null ? '重试点赞设置' : post.liked ? '取消点赞' : '点赞'}} · {{post.likeCount}}</button><button wx:if="{{canDelete}}" bindtap="remove" disabled="{{deleting}}" loading="{{deleting}}">删除本人帖子</button>
<view class="section-title">评论与回复</view><button wx:if="{{commentPage > 1}}" bindtap="firstComments">从第一条开始查看</button>
<view wx:for="{{comments}}" wx:key="id" id="comment-{{item.id}}" class="comment {{item.id === commentId ? 'focused' : ''}}"><view>{{item.author.nickname || '校园同学'}}</view><view class="muted" wx:if="{{item.replyToId}}">回复评论</view><view class="comment-body">{{item.body}}</view><button size="mini" bindtap="reply" data-id="{{item.id}}" data-name="{{item.author.nickname}}" disabled="{{pending || sending}}">回复</button></view>
<view-state state="{{commentState}}" message="{{commentState === 'empty' ? '还没有评论，来聊聊这只猫吧' : commentError}}" bind:retry="retryComments"/><button wx:if="{{commentMore}}" bindtap="moreComments" disabled="{{commentState === 'loading'}}">更多评论</button>
<view wx:if="{{replyToId}}" class="notice">回复 {{replyName}}<button size="mini" bindtap="cancelReply" disabled="{{pending || sending}}">取消回复</button></view><textarea value="{{body}}" bindinput="input" maxlength="-1" disabled="{{pending || sending}}" auto-height placeholder="留下文字评论"/><view class="notice" wx:if="{{pending}}">结果未确认时，请重试原评论；输入已保留。</view><button class="primary" bindtap="send" loading="{{sending}}" disabled="{{sending}}">{{pending ? '确认结果 / 重试原评论' : '发送评论'}}</button><view class="notice" aria-live="polite">{{message}}</view></view><button bindtap="back">返回</button></view>
