<ui-header title="帖子详情" back/><view class="page detail-page"><view-state state="{{state}}" message="{{message}}" bind:retry="load"/><view wx:if="{{post}}"><post-card post="{{post}}" detail/>
<view class="detail-actions"><button class="like-button {{post.liked ? 'is-liked' : ''}}" bindtap="like" loading="{{liking}}" disabled="{{liking}}"><image class="ui-icon" src="/assets/ui/heart-green.png"/><text>{{likeTarget !== null ? '重试' : post.likeCount}}</text></button><button class="delete-button" wx:if="{{canDelete}}" bindtap="remove" disabled="{{deleting}}" loading="{{deleting}}">删除</button></view>
<view class="section-title">评论 {{post.commentCount}}</view><button class="text-button" wx:if="{{commentPage > 1}}" bindtap="firstComments">从第一条开始查看</button>
<view wx:for="{{comments}}" wx:key="id" id="comment-{{item.id}}" class="comment {{item.id === commentId ? 'focused' : ''}}"><view class="comment-author">{{item.author.nickname || '校园同学'}}</view><view class="reply-caption" wx:if="{{item.replyToId}}">回复评论</view><view class="comment-body">{{item.body}}</view><button class="reply-button" bindtap="reply" data-id="{{item.id}}" data-name="{{item.author.nickname}}" disabled="{{pending || sending}}">回复</button></view>
<view-state state="{{commentState}}" message="{{commentState === 'empty' ? '还没有评论，来聊聊这只猫吧' : commentError}}" bind:retry="retryComments"/><button wx:if="{{commentMore}}" bindtap="moreComments" disabled="{{commentState === 'loading'}}">更多评论</button><view class="notice" aria-live="polite">{{message}}</view></view></view>
<view class="composer" wx:if="{{post}}"><view wx:if="{{replyToId || pending}}" class="reply-hint"><text>{{pending ? '确认结果中，请重试原评论' : '回复 ' + replyName}}</text><button class="cancel-reply" wx:if="{{replyToId && !pending}}" bindtap="cancelReply">取消</button></view><view class="composer-row"><textarea value="{{body}}" bindinput="input" maxlength="-1" disabled="{{pending || sending}}" auto-height placeholder="{{replyToId ? '回复 ' + replyName : '说说你的看法…'}}" class="comment-input"/><button class="primary send-button" bindtap="send" loading="{{sending}}" disabled="{{sending}}">{{pending ? '重试' : '发送'}}</button></view></view>
