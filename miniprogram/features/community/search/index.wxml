<view class="page"><view class="title">搜索校园日常</view><input value="{{q}}" bindinput="input" bindconfirm="search" confirm-type="search" maxlength="100" placeholder="搜索正文、话题或猫名"/><button class="primary" bindtap="search">搜索</button><view class="notice" wx:if="{{topicId}}">正在按话题筛选</view><button bindtap="clear">清除搜索和筛选</button><post-card wx:for="{{posts}}" wx:key="id" post="{{item}}" bind:open="openPost"/><view-state state="{{state}}" message="{{state === 'empty' ? '没有匹配的帖子，可清除筛选再试' : message}}" bind:retry="search"/><button wx:if="{{hasMore}}" bindtap="more" disabled="{{state === 'loading'}}">加载更多</button><button bindtap="back">返回</button></view>
