<ui-header title="搜索帖子" back/><view class="page"><view class="search-row"><input value="{{q}}" bindinput="input" bindconfirm="search" confirm-type="search" maxlength="100" placeholder="正文或 Tag"/><button class="primary" bindtap="search">搜索</button></view><view class="filter-line"><text class="muted">{{topicId ? '话题筛选中' : q ? '搜索结果' : '全部公开帖子'}}</text><button class="text-button" bindtap="clear">清除条件</button></view><post-card wx:for="{{posts}}" wx:key="id" post="{{item}}" bind:open="openPost"/><view-state state="{{state}}" message="{{state === 'empty' ? '暂无匹配结果，试试其他关键词' : message}}" bind:retry="search"/><button wx:if="{{hasMore}}" bindtap="more" disabled="{{state === 'loading'}}">加载更多</button></view>
