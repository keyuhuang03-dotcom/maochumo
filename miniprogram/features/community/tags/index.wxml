<ui-header title="选择 Tag" back/><view class="page tags-page"><view class="section-title">话题 Tag · 管理员提供</view><view class="tag-grid"><button wx:for="{{topics}}" wx:key="id" class="choice {{item.selected ? 'selected' : ''}}" bindtap="toggle" data-id="{{item.id}}" data-kind="topic"><image wx:if="{{item.selected}}" class="check" src="/assets/ui/check-green.png"/>{{item.name}}</button></view><view class="section-title cat-heading">猫咪名字 · 支持多选</view><view class="cat-search"><input value="{{q}}" bindinput="input" bindconfirm="search" placeholder="搜索名字或别名" confirm-type="search"/><button bindtap="search"><image class="ui-icon" src="/assets/ui/search-green.png"/></button></view><view class="tag-grid"><button wx:for="{{cats}}" wx:key="id" class="choice {{item.selected ? 'selected' : ''}}" bindtap="toggle" data-id="{{item.id}}" data-kind="cat"><view class="cat-name"><image wx:if="{{item.selected}}" class="check" src="/assets/ui/check-green.png"/>{{item.name}}</view><view class="cat-id">{{item.id}}</view></button></view><view class="notice" wx:if="{{!catLoading && !cats.length}}">没有找到匹配的猫咪，可更换关键词。</view><button wx:if="{{hasMore}}" bindtap="more" disabled="{{catLoading}}">加载更多猫咪</button><view-state state="{{state}}" message="{{message}}" bind:retry="load"/><view class="notice" wx:if="{{message && state !== 'error'}}">{{message}}</view><view class="selection-summary">已选 {{topicIds.length}} 个话题、{{catIds.length}} 只猫<text bindtap="clear">清空</text></view><button class="primary done-button" bindtap="done">完成选择</button></view>
