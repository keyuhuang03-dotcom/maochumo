.header {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  gap: 20rpx;
}
.container {
  padding: 0 24rpx 24rpx;
}
.photo-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 30rpx;
}
.photo {
  width: 220rpx;
  height: 220rpx;
  border-radius: 12rpx;
}
.placeholder {
  width: 220rpx;
  height: 220rpx;
  background: #eee;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #888;
  border-radius: 12rpx;
}
.name {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}
.alias, .row {
  font-size: 28rpx;
  color: #555;
  margin: 8rpx 0;
}
.divider {
  height: 1rpx;
  background: #eee;
  margin: 30rpx 0;
}
.post-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}
.tip {
  text-align: center;
  margin-top: 100rpx;
  color: #888;
}
