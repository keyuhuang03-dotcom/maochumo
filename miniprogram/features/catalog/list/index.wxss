page { background: #fffefa; }
.catalog-page { padding: 20rpx 34rpx 56rpx; }
.search-input { box-sizing: border-box; width: 100%; height: 78rpx; min-height: 78rpx; margin: 0; padding: 0 24rpx; border-radius: 18rpx; background: #f6f4ed; font-size: 25rpx; color: #30392e; }
.search-placeholder { color: #737c6d; }
.filter-scroll { width: 100%; margin: 30rpx 0 62rpx; }
.area-tabs { display: inline-flex; align-items: center; gap: 18rpx; white-space: nowrap; padding-right: 8rpx; }
.area-tab { display: inline-flex; align-items: center; justify-content: flex-start; flex-shrink: 0; box-sizing: border-box; width: auto !important; min-width: 150rpx !important; min-height: 56rpx; margin: 0; padding: 10rpx 18rpx; border-radius: 14rpx; background: #e8eedd; color: #587649; font-size: 22rpx; font-weight: 400; line-height: 1.5; white-space: nowrap; }
.area-tab::after, .clear-filter::after, .load-more::after, .retry-areas::after { border: 0; }
.area-tab.selected { background: #dce7d1; font-weight: 600; box-shadow: inset 0 0 0 2rpx #b1c3a4; }
.cat-list { display: flex; flex-direction: column; gap: 30rpx; }
.clear-filter { width: auto !important; min-height: 60rpx; margin: -40rpx 0 24rpx; padding: 8rpx 0; font-size: 22rpx; color: #587649; background: transparent; font-weight: 400; }
.area-error { color: #737c6d; font-size: 23rpx; margin-bottom: 24rpx; }
.retry-areas { display: inline-block; width: auto !important; min-height: 56rpx; margin: 8rpx 0; padding: 8rpx 16rpx; font-size: 22rpx; }
.load-more { width: 100% !important; margin-top: 30rpx; font-size: 24rpx; }
