.container {
  padding: 16rpx;
  background-color: #FFFEFA;
  min-height: 100vh;
}
.search-bar {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.search-input {
  flex: 1;
  padding: 16rpx;
  background: #fff;
  border-radius: 12rpx;
}
.filter-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.picker-text {
  padding: 12rpx 20rpx;
  background: #fff;
  border-radius: 8rpx;
}
.cat-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.tip {
  text-align: center;
  padding: 30rpx;
  color: #888;
}
.error {
  color: #f56c6c;
}

.filter-bar{display:flex;flex-wrap:wrap;align-items:center;gap:16rpx;margin-bottom:24rpx}.area-picker,.clear-btn{padding:16rpx;color:#587649}.load-more{padding:24rpx;text-align:center;color:#737C6D}
